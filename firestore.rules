rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow anyone to view/listen to beats on your storefront
    match /beats/{beatId} {
      allow read: if true;
      // Only allow writes if you are authenticated as the admin
      allow write: if request.auth != null;
    }
    
    // Default rule for any other collection
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
